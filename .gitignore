# SAML SP key material. This remote is PUBLIC — certs/sp.key is a private key
# and auth_config.json embeds the same key in plaintext. Without these lines a
# single `git add -A` publishes them irrecoverably.
certs/
/auth_config.json
/auth_config_test.json

# Root-level local config and state. These are ANCHORED with a leading slash on
# purpose: an unanchored `authhub_config.py` also matches dev/authhub_config.py,
# which silently drops a tracked rig file from commits.
/authhub_config.py
/authhub_cookie_secret
/authhub.sqlite

.DS_Store
/.vscode
__pycache__
*.egg-info
.venv/
.uv-cache/

# dev rig: the source is tracked, the build output is not.
dev/node_modules/
dev/*.sqlite

# setuptools build tree. `pip install .` and `python -m build` both leave one
# behind, so it reappears after any local packaging run.
/build/
/dist/

# Multi-root editor workspaces. These reference SIBLING repos by relative path
# ("../UserDataHub"), so they only work for a checkout laid out exactly like the
# author's -- local config, same as the /.vscode entry above.
*.code-workspace
